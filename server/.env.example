# Copy to .env to override. All settings are optional.

# --- local model -----------------------------------------------------------
# Any Ollama model that honours JSON Schema in the `format` field.
# llama3.3:70b (~43GB Q4) exceeds a 32GB card and splits ~35% CPU / 65% GPU,
# which is slow but accurate. For a model that fits entirely in 32GB VRAM,
# try qwen2.5:32b — noticeably faster, slightly weaker at planning.
INSIGHT_OLLAMA_MODEL=llama3.3:70b
INSIGHT_OLLAMA_BASE=http://localhost:11434
INSIGHT_OLLAMA_NUM_CTX=16384
INSIGHT_OLLAMA_TIMEOUT=900
# Leave at 0. Non-zero temperature is the main driver of fabricated cards.
INSIGHT_OLLAMA_TEMPERATURE=0.0

# --- semantic pipeline -----------------------------------------------------
# More plans and a larger candidate cap trade run time for recall.
INSIGHT_SEMANTIC_MAX_PLANS=8
INSIGHT_SEMANTIC_CANDIDATE_CAP=400
INSIGHT_SEMANTIC_RETURN_CAP=60

# --- Scryfall --------------------------------------------------------------
# 0.1s between requests = 10 req/s, which is what Scryfall ask for.
# Please keep a descriptive User-Agent; it is a condition of their API terms.
INSIGHT_SCRYFALL_MIN_INTERVAL=0.1
INSIGHT_SCRYFALL_MAX_CONCURRENCY=4
INSIGHT_CACHE_TTL_SECONDS=43200

# --- storage ---------------------------------------------------------------
# INSIGHT_DB_PATH=../data/manafold.sqlite3
