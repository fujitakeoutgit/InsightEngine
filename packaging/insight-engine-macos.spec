# PyInstaller spec for the Mac build: an Insight Engine.app.
#
# A sibling of insight-engine.spec rather than branches inside it. The two
# share their payload and almost nothing else -- the Windows one ends in a
# folder Inno Setup lays down, this one in an application bundle a disk image
# carries -- and a spec that is half `if darwin` is one nobody can read for
# either platform.
#
# Build on a Mac, from the repo root (packaging/build-macos.sh does this):
#     server/.venv/bin/pyinstaller packaging/insight-engine-macos.spec --noconfirm

import os
from pathlib import Path

# SPECPATH is the directory holding this file; the repo root is its parent.
ROOT = Path(SPECPATH).parent          # noqa: F821 - injected by PyInstaller
SERVER = ROOT / "server"

# Passed in by build-macos.sh so the version lives in one place, as the
# Windows build passes it to Inno Setup.
VERSION = os.environ.get("INSIGHT_VERSION", "1.0.0")

datas = [
    # The same payload as the Windows build; see insight-engine.spec for why
    # each is there.
    (str(ROOT / "web" / "dist"), "web/dist"),
    (str(SERVER / "app" / "seed"), "app/seed"),
    (str(ROOT / "packaging" / "seed-mirror.sqlite3"), "."),
]

if not (ROOT / "packaging" / "seed-mirror.sqlite3").exists():
    raise SystemExit(
        "packaging/seed-mirror.sqlite3 is missing. Build it with: "
        "server/.venv/bin/python packaging/make-seed.py"
    )

if not (ROOT / "web" / "dist" / "index.html").exists():
    raise SystemExit(
        "web/dist is missing. Run `npm --prefix web run build` before packaging."
    )

hiddenimports = [
    # uvicorn resolves these by name at runtime, so static analysis misses them.
    "uvicorn.logging",
    "uvicorn.loops.auto",
    "uvicorn.loops.asyncio",
    "uvicorn.protocols.http.auto",
    "uvicorn.protocols.http.h11_impl",
    "uvicorn.protocols.websockets.auto",
    "uvicorn.lifespan.on",
    "dotenv",
    # The menu-bar icon. pystray picks its backend at import time, so the Mac
    # one is invisible to static analysis -- and it reaches AppKit through
    # PyObjC, whose framework wrappers are imported by name the same way.
    "pystray",
    "pystray._darwin",
    "AppKit",
    "Foundation",
    "Quartz",
    "objc",
    "PyObjCTools.AppHelper",
    "PyObjCTools.MachSignals",
    "PIL.Image",
    "PIL.ImageDraw",
]

a = Analysis(                          # noqa: F821
    [str(ROOT / "packaging" / "entry.py")],
    pathex=[str(SERVER)],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    runtime_hooks=[],
    excludes=["pytest", "pytest_asyncio", "_pytest"],
    noarchive=False,
)

pyz = PYZ(a.pure)                      # noqa: F821

exe = EXE(                             # noqa: F821
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="InsightEngine",
    debug=False,
    strip=False,
    upx=False,
    # Windowed, which on a Mac is what makes BUNDLE produce an app rather
    # than a bare executable that opens Terminal.
    console=False,
    # Off: argv emulation runs a Carbon event loop at startup to collect
    # Finder's open-document events, which this app has no use for and which
    # would get in the way of the run loop the menu-bar icon owns.
    argv_emulation=False,
    # Whatever the runner is. The release builds arm64 on Apple silicon and
    # x86_64 on Intel as two downloads rather than one universal2 binary,
    # because every compiled wheel underneath would have to be universal2 too.
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)

coll = COLLECT(                        # noqa: F821
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name="InsightEngine",
)

app = BUNDLE(                          # noqa: F821
    coll,
    name="Insight Engine.app",
    # Regenerated by build-macos.sh from app/icon.py, like the Windows .ico.
    icon=str(ROOT / "packaging" / "insight-engine.icns"),
    bundle_identifier="io.github.fujitakeoutgit.insightengine",
    version=VERSION,
    info_plist={
        "CFBundleName": "Insight Engine",
        "CFBundleDisplayName": "Insight Engine",
        "CFBundleShortVersionString": VERSION,
        "CFBundleVersion": VERSION,
        # A menu-bar app: no Dock icon and no menu bar of its own. The app is
        # the browser tab; the icon by the clock is how to reach it, as the
        # notification-area icon is on Windows.
        "LSUIElement": True,
        "NSHighResolutionCapable": True,
        # The oldest macOS the Python.org/Actions runtimes still build for.
        "LSMinimumSystemVersion": "11.0",
        "NSHumanReadableCopyright": (
            "Card data and images from Scryfall. Unofficial Fan Content "
            "permitted under the Wizards of the Coast Fan Content Policy."
        ),
    },
)
