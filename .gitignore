# Card mirror and cached bulk downloads — rebuildable with `python -m app.bulk`
data/

# Python
server/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
server/.env

# Node
web/node_modules/
web/dist/
*.local
*.tsbuildinfo

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Wizards of the Coast card-back artwork. Used locally by the playtester; not
# redistributed, so it is supplied per-machine rather than committed.
web/public/card-back.png

# Release build outputs. Regenerated by packaging/build-release.ps1.
/build/
/dist/
/release/

# Regenerated by build-release.ps1 from server/app/icon.py.
packaging/insight-engine.ico
packaging/icon-preview.png

# SQLite sidecars. Transient, and the seed mirror is checkpointed and
# self-contained without them.
*.sqlite3-wal
*.sqlite3-shm
